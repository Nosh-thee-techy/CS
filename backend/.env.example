# ========================
# Firebase Configuration
# ========================
# Option A: Path to service account JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Inline credentials (alternative to file path)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ========================
# Server Configuration
# ========================
PORT=3000
NODE_ENV=development

# ========================
# LOOP / NCBA Sandbox API
# ========================
LOOP_BASE_URL=https://sandbox.loop.co.ke
LOOP_TOKEN_URL=https://sandbox.loop.co.ke/oauth2/token
LOOP_CONSUMER_KEY=your-loop-consumer-key
LOOP_CONSUMER_SECRET=your-loop-consumer-secret
LOOP_CALLBACK_URL=http://localhost:3000/api/payouts/loop-callback

# ========================
# Loan Recovery Settings
# ========================
# Maximum percentage of produce payout that can be deducted for loan recovery (0-100)
MAX_LOAN_REPAYMENT_PERCENTAGE=100
