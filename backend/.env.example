# ========================
# Firebase Client SDK
# (Project settings → General → Your apps → Web app)
# Do NOT use a service account JSON / private key on this API.
# ========================
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Optional: sign the backend in as a Firebase Auth user so security rules
# can be `allow read, write: if request.auth != null` instead of open.
# FIREBASE_AUTH_EMAIL=backend@your-project.iam
# FIREBASE_AUTH_PASSWORD=

# ========================
# Server Configuration
# ========================
PORT=3000
NODE_ENV=development

# My Readiness (mounted on this same API)
DEFAULT_LOCALE=en
FEATHERLESS_API_KEY=
FEATHERLESS_API_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# ========================
# Africa's Talking SANDBOX
# Username MUST be "sandbox" or the SDK hits live.
# Simulator: https://simulator.africastalking.com:1517/
# Add demo phones there first: 0700434567, 0712345678
#
# USSD channel create fails if:
#   - you pick a taken code (*384*100# is taken — let AT assign one)
#   - callback is localhost (must be public HTTPS: ngrok/cloudflared → 3000)
#   - callback returns JSON / HTML instead of CON or END
# Callback URL to paste: https://<your-tunnel>/api/ussd   (no ?token=)
# Then copy the code AT created into AT_SHORT_CODE.
# Voice number callback:  https://<your-tunnel>/api/voice
# Leave AT_CALLBACK_SECRET empty in sandbox — AT does not send it.
# ========================
AT_USERNAME=sandbox
AT_API_KEY=
AT_SHORT_CODE=
AT_VOICE_NUMBER=
AT_PUBLIC_BASE_URL=
AT_SMS_FROM=
AT_CALLBACK_SECRET=

# ========================
# LOOP / NCBA Sandbox API
# ========================
LOOP_BASE_URL=https://sandbox.loop.co.ke
LOOP_TOKEN_URL=https://sandbox.loop.co.ke/oauth2/token
LOOP_CONSUMER_KEY=your-loop-consumer-key
LOOP_CONSUMER_SECRET=your-loop-consumer-secret
LOOP_CALLBACK_URL=https://cs-fork.onrender.com/api/payouts/loop-callback
LOOP_REPAYMENT_CALLBACK_URL=https://cs-fork.onrender.com/api/loans/loop-repayment-callback
LOOP_MERCHANT_TILL=133239
LOOP_MERCHANT_TILL_SECRET=your-loop-merchant-till-secret

# ========================
# Loan Recovery Settings
# ========================
# Maximum percentage of produce payout that can be deducted for loan recovery (0-100)
MAX_LOAN_REPAYMENT_PERCENTAGE=100
